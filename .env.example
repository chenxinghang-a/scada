# SCADA System Environment Variables
# Copy to .env and fill in real values for production.
# 所有 CHANGE_ME 必须替换；禁止把真实值提交进版本库。

# 运行环境：development / production
# production 下未设置下列密钥会在启动时产生 CRITICAL 告警
SCADA_ENV=development

# ===== 核心密钥（生产必填）=====
# Flask 会话密钥（同时供 配置/system.yaml 的 web.secret_key 引用）
SECRET_KEY=CHANGE_ME
# JWT 签名密钥
JWT_SECRET=CHANGE_ME
# CSRF 令牌密钥（未设置时系统会生成并尝试持久化到 .env，生产应显式设置）
CSRF_SECRET=CHANGE_ME
# 首次创建 admin 账户的初始密码（生产必须覆盖，禁止使用弱口令）
SCADA_ADMIN_PASSWORD=CHANGE_ME

# ===== 运行时目录（留空 = 默认布局）=====
# SCADA_DATA_DIR / SCADA_CONFIG_DIR 是**目录**，不是数据库文件路径。
# 库文件名由运行模式派生（模拟 → data/scada_simulated.db，真实 → data/scada_real.db）。
# 相对路径按项目根解析（不按当前工作目录）。多实例隔离见 tools/multi_instance.py。
# ⚠️ 这里此前写的是 SCADA_DB_PATH=data/scada.db —— 那个变量**从来没有代码读**
#    （round 206 删除），设了也不生效。
SCADA_DATA_DIR=
SCADA_CONFIG_DIR=

# ===== 数据库 =====
# 库路径不可直接指定：它由 SCADA_DATA_DIR + 运行模式派生（见上）。
# 若确实需要外部库，请设 SCADA_DATA_DIR 指向该目录。

# ===== MQTT =====
MQTT_BROKER=localhost
MQTT_PORT=1883
# MQTT 采集账号（配置/devices*.yaml 中 ${MQTT_SCADA_USER}/${MQTT_SCADA_PASSWORD}）
MQTT_SCADA_USER=CHANGE_ME
MQTT_SCADA_PASSWORD=CHANGE_ME

# MQTT TLS/SSL
MQTT_TLS_ENABLED=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_TLS_INSECURE=false

# ===== PA 广播 =====
PA_BROKER=localhost
PA_MQTT_PORT=1883

# ===== TDengine 时序库（可选）=====
TDENGINE_HOST=localhost
TDENGINE_PORT=6041
TDENGINE_USER=root
TDENGINE_PASSWORD=CHANGE_ME
TDENGINE_DATABASE=scada

# ===== 设备/外部系统凭据（配置/devices*.yaml 中的 ${VAR} 引用）=====
# 西门子 S7-1500 REST 备用通道（basic 认证，用户名 admin）
DEVICE_REST_ADMIN_PASSWORD=CHANGE_ME
# MES 系统 Bearer Token
MES_API_TOKEN=CHANGE_ME
# ERP 系统 Bearer Token
ERP_API_TOKEN=CHANGE_ME
# EMS 能源系统 basic 认证密码
EMS_API_PASSWORD=CHANGE_ME
# WMS 仓储系统 basic 认证密码
WMS_API_PASSWORD=CHANGE_ME

# ===== 真实设备主机注入（配置/devices_real.yaml 中的 ${VAR} 引用）=====
# 现场真实设备地址，SAT 前由部署方填写
PLC_HOST_01=CHANGE_ME

# ===== Application =====
# 运行模式**不是**环境变量：由 run.py 的命令行开关决定
#   python run.py                  → 模拟模式（devices_simulated.yaml，端口 5000）
#   python run.py --simulator      → 外部 Modbus TCP 模拟器（真实协议，端口 5001）
#   python run.py --real           → 真实设备（devices_real.yaml，端口 5001）
# 此处曾有一个 SCADA_MODE=simulated，从未被任何代码读取，已删除（round 206）。
# 容器部署必须 SCADA_HOST=0.0.0.0：只监听 127.0.0.1 时 docker 端口发布打不到。
SCADA_HOST=127.0.0.1
SCADA_PORT=5000
SCADA_REAL_PORT=5001
# Flask 调试模式。⚠️ 变量名是 FLASK_DEBUG —— 这里此前写的 DEBUG 从未被读。
FLASK_DEBUG=0

# ===== Logging (structured JSON for SIEM integration) =====
SCADA_LOG_DIR=logs
SCADA_LOG_LEVEL=INFO
SCADA_LOG_JSON=true
SCADA_LOG_ROTATION=100 MB
SCADA_LOG_RETENTION=30 days
