# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.eggs/
*.egg-info/
dist/
build/

# 构建产物与备份目录
# 本机规避"批量删除保护"时用「改名代替删除」产生（mv dist dist.prev-xxx），
# 以及 PyInstaller 的历史产物目录。都不该进版本库。
# 通配形如 build.prev / dist.prev-local / scada-backend.prev-0918 等。
build.prev*/
dist.prev*/
*.prev*/

# Virtual environments
.venv/
venv/

# Data (DB files and CSV exports)
data/*.db
data/*.db-wal
data/*.db-shm
data/queue/
# 运行时发现文件（run.py 每次启动写入实际端口/pid/mode）
data/runtime.json
# 运行期标准输出/错误转储（历史误跟踪，建议 git rm --cached 清理）
data/run_*.log
exports/*.csv

# Logs
logs/*.log
logs/*.log.*
# 运行期审计流水（每跑一次服务/测试都会追加）—— 与 data/audit_log.jsonl 同一口径
logs/ops_audit.jsonl

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# PyInstaller
*.exe
*.spec
# 例外：后端打包配方必须进 git，否则新克隆的仓库无法复现打包
# （此前它被 *.spec 规则挡在 git 外面，磁盘上有文件但 git 里没有）
!scada-backend.spec
build/
dist/

# Docker
.env
!.env.example

# Testing
.pytest_cache/
.coverage
# pytest-cov 在并行/异常路径下会留下 .coverage.<host>.<pid>.<随机串> 临时文件，
# 只写 `.coverage` 拦不住它们
.coverage.*
coverage.xml
htmlcov/

# Type checking
.pyright/

# Backup & misc
*.bak
backup/
stderr*.txt
stdout*.txt

# 运行期产物：审计日志由服务端与测试追加写入（每跑一次测试就多几十条），
# 不是源码，不进 git。此前被跟踪导致每轮提交都夹带测试垃圾。
data/audit_log.jsonl
